<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <QuestScriptDef>
        <defName>FCP_Quest_Abolitionist_Liberation</defName>
        <rootSelectionWeight>1.0</rootSelectionWeight>
        <rootMinPoints>150</rootMinPoints>
        <defaultChallengeRating>2</defaultChallengeRating>
        <canGiveRoyalFavor>false</canGiveRoyalFavor>
        <expireDaysRange>5~10</expireDaysRange>
        <questNameRules>
            <rulesStrings>
                <li>questName->Breaking the Chains</li>
                <li>questName->The Holding Pen</li>
                <li>questName->Nobody's Property</li>
                <li>questName->A Debt to the Living</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>requirements->Requirements: defeat every hostile holding the pen. If they scatter before you arrive, whoever's still chained up there is gone with them.</li>
                <li>questDescription->[asker_nameFull] has word of a Slaver outpost holding people who haven't been sold off yet. [asker_pronoun] can't spare the guns to hit it, but [asker_pronoun] knows people who can.\n\n[requirements]</li>
                <li>questDescription->[asker_nameFull]: "There's a pen not far from here, still got people in it waiting to be shipped out. We don't have the numbers to take it. You might."\n\n[requirements]</li>
                <li>questDescription->A Slaver holding pen sits within reach, and [asker_nameFull] wants it emptied before the next shipment goes out. Whatever you take off their hands afterward is yours to keep.\n\n[requirements]</li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="QuestNode_SubScript">
                    <def>Util_RandomizePointsChallengeRating</def>
                    <parms>
                        <pointsFactorTwoStar>1.3</pointsFactorTwoStar>
                        <pointsFactorThreeStar>1.7</pointsFactorThreeStar>
                    </parms>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_AdjustPointsForDistantFight</def>
                </li>
                <li Class="QuestNode_GetMap" />
                <li Class="FCP.Core.RadiantQuests.QuestNode_GetFactionFromList">
                    <storeAs>askerFaction</storeAs>
                    <mustBeNonHostile>false</mustBeNonHostile>
                    <factionDefs>
                        <li>FCP_Faction_Abolitionists</li>
                    </factionDefs>
                </li>
                <li Class="FCP.Core.RadiantQuests.QuestNode_GetLeaderOfFaction">
                    <storeAs>asker</storeAs>
                    <factionToUse>$askerFaction</factionToUse>
                </li>
                <li Class="FCP.Core.RadiantQuests.QuestNode_GetFactionFromList">
                    <storeAs>siteFaction</storeAs>
                    <mustBeNonHostile>false</mustBeNonHostile>
                    <factionDefs>
                        <li>FCP_Faction_Slaver</li>
                    </factionDefs>
                </li>
                <li Class="QuestNode_GetSiteTile">
                    <storeAs>siteTile</storeAs>
                    <preferCloserTiles>true</preferCloserTiles>
                </li>
                <li Class="QuestNode_GetDefaultSitePartsParams">
                    <tile>$siteTile</tile>
                    <faction>$siteFaction</faction>
                    <sitePartDefs>
                        <li>FCP_Site_Abolitionist_Slaver_Holding_Pen</li>
                    </sitePartDefs>
                    <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
                </li>
                <li Class="QuestNode_SubScript">
                    <def>Util_GenerateSite</def>
                    <parms>
                        <hiddenSitePartsPossible>true</hiddenSitePartsPossible>
                    </parms>
                </li>
                <li Class="QuestNode_SpawnWorldObjects">
                    <worldObjects>$site</worldObjects>
                </li>
                <li Class="QuestNode_WorldObjectTimeout">
                    <worldObject>$site</worldObject>
                    <isQuestTimeout>true</isQuestTimeout>
                    <delayTicks>$(randInt(12,24)*60000)</delayTicks>
                    <inSignalDisable>site.MapGenerated</inSignalDisable>
                    <node Class="QuestNode_End">
                        <outcome>Fail</outcome>
                        <sendStandardLetter>true</sendStandardLetter>
                    </node>
                </li>
                <li Class="QuestNode_Signal">
                    <inSignal>site.AllEnemiesDefeated</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <letterDef>PositiveEvent</letterDef>
                                <label>Chains broken</label>
                                <text>The holding pen is cleared. Whoever the Slavers had penned up there is free now, and word of it will reach Hannibal Hamlin.</text>
                            </li>
                            <li Class="QuestNode_Notify_PlayerRaidedSomeone">
                                <getRaidersFromMapParent>$site</getRaidersFromMapParent>
                            </li>
                            <li Class="QuestNode_GiveRewards">
                                <parms>
                                    <allowGoodwill>true</allowGoodwill>
                                    <allowRoyalFavor>false</allowRoyalFavor>
                                </parms>
                                <addCampLootReward>true</addCampLootReward>
                                <customLetterLabel>Word from the Abolitionists</customLetterLabel>
                                <customLetterText>The Abolitionists heard what you did. It won't buy you an army, but it's bought you their trust.</customLetterText>
                            </li>
                        </nodes>
                    </node>
                </li>
                <li Class="QuestNode_End">
                    <inSignal>site.AllEnemiesDefeated</inSignal>
                    <outcome>Success</outcome>
                </li>
                <li Class="QuestNode_NoWorldObject">
                    <worldObject>$site</worldObject>
                    <node Class="QuestNode_End" />
                </li>
            </nodes>
        </root>
    </QuestScriptDef>

</Defs>
