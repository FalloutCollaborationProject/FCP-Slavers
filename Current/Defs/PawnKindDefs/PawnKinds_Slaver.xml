<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Pawnkinds __________-->

    <!--_____ Slavers _____-->

    <!-- Base Slaver -->
    
    <PawnKindDef Name="FCP_SlaverBase" Abstract="True">
        <race>Human</race>
        <defaultFactionType>FCP_Faction_Slaver</defaultFactionType>
        <chemicalAddictionChance>0.15</chemicalAddictionChance>
        <invNutrition>2.55</invNutrition>
        <itemQuality>Poor</itemQuality>
        <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
        <forceNormalGearQuality>true</forceNormalGearQuality>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
    </PawnKindDef>

    <!-- Slaver Boss -->
    
    <PawnKindDef ParentName="FCP_SlaverBase">
        <defName>FCP_Slaver_Boss</defName>
        <label>slaver boss</label>
        <labelPlural>slaver bosses</labelPlural>
        <combatPower>120</combatPower>
        <canBeSapper>true</canBeSapper>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.8~1.8</gearHealthRange>
        <apparelMoney>1200~2000</apparelMoney>
        <weaponMoney>800~1200</weaponMoney>
        <weaponTags>
            <li MayRequire="Rick.FCP.BallisticWeapons">FCP_Shotgun</li>
            <li MayRequire="Rick.FCP.BallisticWeapons">FCP_SMG</li>
            <li MayRequire="Rick.FCP.BallisticWeapons">FCP_Assault_Rifle</li>
            <li MayRequire="Rick.FCP.MeleeWeapons">FCP_Melee_Blunt</li>
            <li>IndustrialGunAdvanced</li>
            <li>IndustrialMeleeAdvanced</li>
        </weaponTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Slavers</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <forcedTraits>
            <li>
                <def>Psychopath</def>
            </li>
        </forcedTraits>
        <initialWillRange>3~6</initialWillRange>
        <initialResistanceRange>25~35</initialResistanceRange>
        <inventoryOptions>
            <skipChance>0.50</skipChance>
            <subOptionsChooseOne>
                <li>
                    <thingDef>FCP_Currency_Caps</thingDef>
                    <countRange>50~150</countRange>
                </li>
                <li>
                    <thingDef>PsychiteTea</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef>Beer</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.Chems">FCP_Chem_Psycho</thingDef>
                    <countRange>2~3</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.Chems">FCP_Chem_Jet</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.Chems">FCP_Chem_Buffout</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.Chems">FCP_Chem_Stimpak</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.Chems">FCP_Chem_MedX</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.WastelandFood">FCP_Food_Black_Blood_Sausage</thingDef>
                    <countRange>1~2</countRange>
                </li>
                <li>
                    <thingDef MayRequire="Rick.FCP.NukaCola">FCP_Nuka_Cola</thingDef>
                    <countRange>1~2</countRange>
                </li>
            </subOptionsChooseOne>
        </inventoryOptions>
        <apparelTags>
            <li>FCP_Slaver_Apparel</li>
            <li>FCP_Raider_Apparel</li>
            <li>FCP_Wastelander_Apparel</li>
            <li>FCP_Combat_Armor_Modular</li>
            <li>FCP_Combat_Armors</li>
        </apparelTags>
        <apparelDisallowTags>
            <li>FCP_BoS_Apparel</li>
            <li>FCP_NCR_Apparel</li>
            <li>FCP_Legion_Apparel</li>
            <li>FCP_Enclave_Apparel</li>
            <li>FCP_USA_Apparel</li>
            <li>FCP_Minutemen_Combat_Armor_Modular</li>
            <li>FCP_Weapon_USA_Alloy_Steel_Assault_Rifle</li>
            <li>FCP_Great_Khan_Armor</li>
            <li>FCP_Great_Khan_Helmet</li>
        </apparelDisallowTags>
    </PawnKindDef>

