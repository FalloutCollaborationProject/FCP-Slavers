<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Pawnkinds __________-->

    <!--_____ Paradise Falls (Unique) _____-->

    <!-- Eulogy Jones -->

    <PawnKindDef ParentName="FCP_SlaverBase">
        <defName>FCP_Unique_Pawnkind_Eulogy_Jones</defName>
        <label>Eulogy Jones</label>
        <showInDebugSpawner>false</showInDebugSpawner>
        <factionLeader>true</factionLeader>
        <combatPower>90</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.8~1.8</gearHealthRange>
        <apparelRequired>
            <li>FCP_Apparel_Business_Pre_War</li>
        </apparelRequired>
        <weaponMoney>500~800</weaponMoney>
        <apparelAllowHeadgearChance>0.2</apparelAllowHeadgearChance>
        <weaponTags>
            <li MayRequire="Rick.FCP.BallisticWeapons">FCP_Pistol</li>
            <li MayRequire="Rick.FCP.MeleeWeapons">FCP_Melee_Blunt</li>
        </weaponTags>
        <requiredWorkTags>
            <li>Social</li>
        </requiredWorkTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Slaver_Eulogy_Jones</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <initialWillRange>6~9</initialWillRange>
        <initialResistanceRange>22~30</initialResistanceRange>
    </PawnKindDef>

