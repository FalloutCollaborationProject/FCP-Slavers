        <bodyTypeMale>Male</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>FCP_Backstory_Slaver_Cutter</li>
        </spawnCategories>
        <skillGains>
            <Medicine>9</Medicine>
            <Intellectual>4</Intellectual>
            <Social>2</Social>
        </skillGains>
    </BackstoryDef>

