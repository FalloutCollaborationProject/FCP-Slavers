    <!--___ Paradise Falls (Unique) ___-->

    <BackstoryDef>
        <defName>FCP_Slaver_Eulogy_Jones</defName>
        <title>head slaver</title>
        <titleShort>head slaver</titleShort>
        <baseDesc>[PAWN_nameDef] talked, bribed, and eventually murdered [PAWN_possessive] way to the top of Paradise Falls, and has kept it running on charm and threats ever since. [PAWN_pronoun] never gets [PAWN_possessive] own hands dirty when someone else's will do.</baseDesc>
        <bodyTypeMale>Male</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>FCP_Backstory_Slaver_Eulogy_Jones</li>
        </spawnCategories>
        <skillGains>
            <Social>9</Social>
            <Intellectual>3</Intellectual>
            <Melee>2</Melee>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>FCP_Slaver_Grouse</defName>
        <title>gatekeeper</title>
        <titleShort>gatekeeper</titleShort>
        <baseDesc>[PAWN_nameDef] mans the gate and doesn't let anyone through without paying for the privilege. Slaving is the family trade; [PAWN_possessive] father ran Paradise Falls until Eulogy Jones took the job from him the hard way, and [PAWN_nameDef] never brought it up again.</baseDesc>
        <bodyTypeMale>Male</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>FCP_Backstory_Slaver_Grouse</li>
        </spawnCategories>
        <skillGains>
            <Social>4</Social>
            <Shooting>4</Shooting>
            <Crafting>2</Crafting>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>FCP_Slaver_Forty</defName>
        <title>pen watcher</title>
        <titleShort>pen watcher</titleShort>
        <baseDesc>[PAWN_nameDef] watches the slave pens for Eulogy Jones, a job that mostly means making sure nobody gets any clever ideas. [PAWN_pronoun] earned the name for a body count [PAWN_pronoun] stopped bothering to track once the victims stopped being able to fight back.</baseDesc>
        <bodyTypeMale>Hulk</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>FCP_Backstory_Slaver_Forty</li>
        </spawnCategories>
        <skillGains>
            <Melee>6</Melee>
            <Shooting>2</Shooting>
            <Intellectual>-3</Intellectual>
        </skillGains>
    </BackstoryDef>

