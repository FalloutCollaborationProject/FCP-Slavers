        <skillGains>
            <Shooting>4</Shooting>
            <Melee>3</Melee>
            <Social>2</Social>
        </skillGains>
        <forcedTraits>
            <Psychopath>0</Psychopath>
        </forcedTraits>
    </BackstoryDef>

