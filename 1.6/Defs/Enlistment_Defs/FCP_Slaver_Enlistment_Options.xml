<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Enlistments with Factions __________-->

    <!--_____ Slavers _____-->

    <FCP.Enlist.FactionEnlistOptionsDef>
        <defName>FCP_Enlistment_Slaver</defName>
        <currencyDef>Silver</currencyDef>
        <minGoodwillRequrementToEnlist>-10</minGoodwillRequrementToEnlist>
        <enlistGoodwillGain>5</enlistGoodwillGain>

        <!-- Enlistment Options -->

        <enlistLetterTitleKey>FCP_Slaver_Enlist_Letter_Title</enlistLetterTitleKey>
        <enlistLetterLabelKey>FCP_Slaver_Enlist_Letter_Label</enlistLetterLabelKey>
        <enlistButtonLabelKey>FCP_Slaver_Enlist_Button_Label</enlistButtonLabelKey>
        <enlistButtonDescKey>FCP_Slaver_Enlist_Button_Desc</enlistButtonDescKey>
        <enlistRequrementsNotSatisfiedKey>FCP_Slaver_Enlist_Requrements_Not_Satisfied</enlistRequrementsNotSatisfiedKey>
        <enlistedToHostileFactionKey>FCP_Slaver_Enlisted_To_Hostile_Faction</enlistedToHostileFactionKey>
        <enlistButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</enlistButtonIconTexPath>
        <enlistedWithKey>FCP_Slaver_Enlisted_With_Key</enlistedWithKey>

        <!-- Mission Options -->

        <missionsAreEnabled>true</missionsAreEnabled>
        <missionsLabelKey>FCP_Slaver_Missions_Label</missionsLabelKey>
        <missionsDescKey>FCP_Slaver_Missions_Desc</missionsDescKey>
        <missionsButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</missionsButtonIconTexPath>
        <missionsBackgroundMenuTexPath>World/WorldObjects/Expanding/WasterPirates</missionsBackgroundMenuTexPath>
        <missionsMenuDescriptionKey>FCP_Slaver_Menu_Missions_Desc</missionsMenuDescriptionKey>
        <missionsMenuSelectQuestKey>FCP_Slaver_Menu_Missions_Select_Quest</missionsMenuSelectQuestKey>
        <missionsMenuStartQuestKey>FCP_Slaver_Menu_Missions_Start_Quest</missionsMenuStartQuestKey>
        <missionsQuestCost>100</missionsQuestCost>
        <missionsMenuStartQuestNoEnoughMoneyKey>FCP_Slaver_Not_Enough_Money</missionsMenuStartQuestNoEnoughMoneyKey>

        <!-- Salary Options -->

        <salaryIsEnabled>true</salaryIsEnabled>
        <salaryDef>Silver</salaryDef>
        <salaryLabelKey>FCP_Slaver_Salary_Label</salaryLabelKey>
        <salaryDescKey>FCP_Slaver_Salary_Desc</salaryDescKey>
        <salaryButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</salaryButtonIconTexPath>
        <salaryRange>600~1200</salaryRange>
        <salaryPeriodDays>10</salaryPeriodDays>

        <!-- Provision Options -->

        <provisionOptions>
            <li>
                <provisionsLabelKey>FCP_Slaver_Provisions_Label</provisionsLabelKey>
                <provisionsDescKey>FCP_Slaver_Provisions_Desc</provisionsDescKey>
                <provisionsButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</provisionsButtonIconTexPath>
                <provisions>
                    <li>
                        <thing>MealSurvivalPack</thing>
                        <amountRange>12</amountRange>
                    </li>
                    <li>
                        <thing>MedicineIndustrial</thing>
                        <amountRange>4</amountRange>
                    </li>
                </provisions>
                <provisionsRestockInDays>15</provisionsRestockInDays>
            </li>
        </provisionOptions>

        <!-- Storage Options -->

        <storageIsEnabled>true</storageIsEnabled>
        <storageLabelKey>FCP_Slaver_Storage_Label</storageLabelKey>
        <storageDescKey>FCP_Slaver_Storage_Desc</storageDescKey>
        <storageButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</storageButtonIconTexPath>

        <!-- Work Options -->

        <recreationGainPerTick>0.0001</recreationGainPerTick>
        <workOptions>
            <li>
                <workLabelKey>FCP_Slaver_Guard_Duty_Label</workLabelKey>
                <workDescKey>FCP_Slaver_Guard_Duty_Desc</workDescKey>
                <workButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</workButtonIconTexPath>
                <additionalRestFall>0.30</additionalRestFall>
                <silverGainPerHour>15</silverGainPerHour>
            </li>
        </workOptions>

        <!-- Bounty Options -->

        <turnInIsEnabled>true</turnInIsEnabled>
        <turnInLabelKey>FCP_Slaver_Turn_In_Label</turnInLabelKey>
        <turnInDescKey>FCP_Slaver_Turn_In_Desc</turnInDescKey>
        <turnInButtonIconTexPath>World/WorldObjects/Expanding/WasterPirates</turnInButtonIconTexPath>
        <turnInTraderKind>FCP_Caravan_Slaver_Slave_Trader</turnInTraderKind>
        <turnInRefreshSilverInDays>7</turnInRefreshSilverInDays>
        <turnInTraderNameKey>FCP_Slaver_Turn_In_Trader_Name</turnInTraderNameKey>

        <!-- Resign Options -->

        <resignGoodwillGain>-15</resignGoodwillGain>
        <resignMenuTextKey>FCP_Slaver_Resign_Menu_Text</resignMenuTextKey>
        <resignLetterTitleKey>FCP_Slaver_Resign_Letter_Title</resignLetterTitleKey>
        <resignLetterLabelKey>FCP_Slaver_Resign_Letter_Label</resignLetterLabelKey>
        <resignButtonLabelKey>FCP_Slaver_Resign_Button_Label</resignButtonLabelKey>
        <resignButtonDescKey>FCP_Slaver_Resign_Button_Desc</resignButtonDescKey>

        <!-- Kicked Out Options -->

        <kickOutLetterTitleKey>FCP_Slaver_Kick_Out_Letter_Title</kickOutLetterTitleKey>
        <kickOutLetterLabelKey>FCP_Slaver_Kick_Out_Label_Title</kickOutLetterLabelKey>

    </FCP.Enlist.FactionEnlistOptionsDef>

</Defs>
